    "./watcher": "./src/watcher.ts",
    "./watchConfig": "./src/watchConfig.ts",
    "./paths": "./src/paths.ts",
    "./buildWorker": "./src/buildWorker.ts",
    "./launchAgent": "./src/launchAgent.ts"
  }
