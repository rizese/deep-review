{
  "extends": "../../tsconfig.base.json",
  "include": [
    "electron.vite.config.*",
    "src/*.ts",
    "src/main/**/*",
    "src/types/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "electron-vite/node",
      "node"
    ]
  }
}
