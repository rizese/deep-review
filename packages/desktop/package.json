{
  "name": "@deep-review/desktop",
  "version": "0.1.0",
  "description": "Deep Review as a desktop app: the server, the watcher and the pages in one window",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Ricky Zese",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run --passWithNoTests",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "electron-vite build && electron-builder --dir",
    "build:mac": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.39",
    "@ai-sdk/openai": "^4.0.45",
    "@ai-sdk/xai": "^4.0.42",
    "@deep-review/call-graph": "workspace:*",
    "@deep-review/pr": "workspace:*",
    "@deep-review/review": "workspace:*",
    "@deep-review/slicer": "workspace:*",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "ai": "^7.0.69",
    "diff": "^8.0.4",
    "lucide-react": "^1.46.0",
    "pyright": "^1.1.390",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "31.7.5",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "vite": "^5.3.1"
  }
}
